# ─────────────────────────────────────────────────────────────────────────────
# Configuration de l'app mobile Djeli'S — copier en `.env` pour le DÉVELOPPEMENT.
#
# ⚠️ NE JAMAIS mettre de secret ici (le `.env` est embarqué dans l'APK en dev).
# ⚠️ En RELEASE, ne pas dépendre de ce fichier : passer les valeurs au build via
#    --dart-define (voir docs/ANDROID_SIGNING.md et le README).
# ─────────────────────────────────────────────────────────────────────────────

# URL publique de l'API backend, SANS "/" final. Doit inclure le préfixe /api/v1.
# Émulateur Android -> l'hôte local est 10.0.2.2.
API_BASE_URL=http://10.0.2.2:3000/api/v1

# Environnement logique : development | staging | production
APP_ENV=development

# V1 de lancement : DjaaSoo "Bientôt disponible", aucun abonnement/paiement.
# Mettre "false" le jour de l'ouverture. Défaut applicatif = true.
LAUNCH_MODE_V1=true

# DSN Sentry (crash reporting). Vide = désactivé (aucune donnée envoyée).
SENTRY_DSN=

# ── Build release (exemple de commande) ──────────────────────────────────────
# Backend prod actuel (Vercel) : https://backend-alpha-five-15.vercel.app/api/v1
# (domaine généré Vercel ; un domaine stable type https://api.djelis.com est
#  recommandé avant la production publique).
#
# flutter build appbundle --release \
#   --dart-define=API_BASE_URL=https://backend-alpha-five-15.vercel.app/api/v1 \
#   --dart-define=APP_ENV=production \
#   --dart-define=LAUNCH_MODE_V1=true \
#   --dart-define=SENTRY_DSN=https://xxxxx@oXXXX.ingest.sentry.io/XXXX
