# Djeli'S web-app — modèle de configuration (copier en `.env.local`).
# NE JAMAIS committer `.env.local`. Aucune valeur réelle ici.

# URL publique de l'API backend, SANS "/" final.
# ATTENTION : inlinée dans le bundle client au build. Doit être définie
# comme variable d'environnement de build sur Vercel, sinon la prod
# appellera localhost.
NEXT_PUBLIC_API_URL=https://api.exemple.djelis.com

# Supabase (client navigateur) — clé anon uniquement, jamais la service_role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secrets serveur (routes /api/webhooks/*) — définis côté hébergeur, pas ici.
# WAVE_WEBHOOK_SECRET=
# CINETPAY_SECRET=
