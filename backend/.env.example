# ─────────────────────────────────────────────────────────────────────────────
# Djeli'S backend — modèle de configuration.
# Copier en `.env` et renseigner les valeurs. NE JAMAIS committer le `.env`.
# Les valeurs ci-dessous sont des exemples de format, pas des secrets réels.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (Supabase / PostgreSQL) ─────────────────────────────────
# URL via le pooler transaction-mode (runtime applicatif)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# URL via le pooler session-mode (migrations Prisma)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Authentification JWT ───────────────────────────────────────────────────
# Chaînes aléatoires >= 32 caractères. Doivent être IDENTIQUES sur tous les
# backends qui partagent les mêmes utilisateurs. Générer : openssl rand -hex 32
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV="development"          # "production" en prod
PORT="3000"
# Origines web autorisées EN PLUS de djelis.com (CSV). Utile si le web-app
# tourne sur un domaine Vercel de preview / un domaine custom différent.
EXTRA_CORS_ORIGINS=""

# ── Supabase Storage (upload + lecture signée des médias) ──────────────────
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Clé service_role (PAS la clé anon). Secret critique : contourne la RLS.
SUPABASE_SERVICE_ROLE_KEY=""
# Nom exact du bucket de stockage (défaut applicatif : "media").
SUPABASE_STORAGE_BUCKET="media"

# ── URLs de redirection et webhooks ─────────────────────────────────────────
APP_URL="https://djelis.com"
PUBLIC_API_URL="https://api.djelis.com"

# ── Passerelles de paiement ────────────────────────────────────────────────
# Wave (API Checkout directe + secret webhook HMAC)
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""

# CinetPay (API Checkout directe + secret webhook HMAC)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET=""

# Listes d'IP autorisées pour les webhooks (séparées par des virgules).
# Requises en production, sinon /payments/webhooks/:gateway renvoie 401.
ALLOWED_IPS_WAVE=""
ALLOWED_IPS_CINETPAY=""

# ── Notifications (e-mail & SMS) ──────────────────────────────────────────
# E-mail transactionnel via Resend. Si vide, les e-mails (reset mot de passe…)
# sont seulement journalisés — le flux ne casse pas.
RESEND_API_KEY=""
EMAIL_FROM="Djeli'S <no-reply@djelis.com>"
# SMS / OTP via Twilio. Si vide, les codes sont seulement journalisés.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Base d'URL du site, utilisée pour le lien de réinitialisation de mot de passe.
APP_URL="https://djelis.com"

# ── Dev uniquement — NE PAS définir en production ─────────────────────────
# ENABLE_PAYMENT_SIMULATION="true"   # active le mode paiement simulé
# AUTH_DEBUG_CODES="true"            # journalise les OTP / liens de reset
